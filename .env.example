# Copy this file to .env.local for local testing, or add these
# keys directly in your Vercel Project Settings (Settings -> Environment Variables).

# 1. Google Apps Script Web App Deployment URL (Backend Database)
# Set your Apps Script URL below. Both serverless proxy and client use this.
VITE_GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbwb-LmuQ2TiUQEGmdWKZAKd9jB9hxeIESL4i-F0h-NwSba8BEbdTaqhato_9aWeXlxy/exec"
