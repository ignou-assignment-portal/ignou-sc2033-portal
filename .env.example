# 2. Dual-Mode API Switch
# - false (Default & Recommended): Uses Vercel Serverless Function (/api/sheets) to proxy requests and prevent CORS.
# - true: Makes direct browser fetch requests directly to the Google Apps Script Web App URL.
VITE_DIRECT_SHEETS="false"

